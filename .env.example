# Copier en .env.local et renseigner. Toutes ces variables sont validées par
# src/config/env.ts (Zod) : le démarrage échoue si l'une manque ou est invalide.
# Ne jamais committer de valeur réelle.

# Rôle applicatif `cabinet_app` : aucun droit DDL, ne peut pas modifier le journal
# d'audit. C'est cette URL que l'application utilise.
DATABASE_URL=

# Rôle propriétaire : migrations Prisma uniquement, jamais l'application.
# Les lancer avec DATABASE_URL rendrait cabinet_app propriétaire des tables et
# annulerait les REVOKE qui protègent le journal d'audit.
DIRECT_DATABASE_URL=

# Agenda en direct (D61) : LISTEN exige une connexion directe. Facultative — à
# poser seulement quand DATABASE_URL passe par un pooler (Neon : hôte sans -pooler).
REALTIME_DATABASE_URL=



# Durée d'inactivité avant verrouillage de session, en minutes.
# Fournisseur de SMS (Brevo). FACULTATIFS, mais indissociables : sans les DEUX,
# le développement affiche les codes dans le terminal et la production refuse
# d'envoyer plutôt que d'échouer en silence.
# L'expéditeur est plafonné à 11 caractères et doit être déclaré chez Brevo.
BREVO_API_KEY=
BREVO_SMS_EXPEDITEUR=

# Canal e-mail (phase 4, lot 2). Partage BREVO_API_KEY avec le SMS. FACULTATIVE :
# sans elle, l'e-mail se comporte comme le SMS sans opérateur (console hors
# production, refus en production).
BREVO_EMAIL_EXPEDITEUR=

# Hors production : les SEULS numéros qui reçoivent un vrai SMS, séparés par des
# virgules (+590…, 0690…, avec ou sans espaces). Tous les autres s'écrivent dans
# le terminal de `npm run dev`. Vide = aucun SMS réel hors production.
# Mettre ici son propre numéro pour éprouver un envoi réel. Ignorée en production.
SMS_NUMEROS_AUTORISES=

# Même garde-fou, pour le canal e-mail : les SEULES adresses qui reçoivent un
# vrai e-mail hors production, séparées par des virgules. Vide = aucun e-mail
# réel hors production. Ignorée en production.
EMAIL_ADRESSES_AUTORISEES=

SESSION_IDLE_TIMEOUT_MINUTES=15

# Marque les cookies `Secure`. DOIT valoir true en production : sans lui, un
# cookie de session peut être capté en clair sur le réseau. Le seul cas
# légitime de `false` est une démonstration servie en HTTP sur un réseau privé.
SESSION_COOKIE_SECURE=true

# Conservation du journal d'audit, en mois. Passé à purge_audit_log() par la tâche
# planifiée. 36 est un PLACEHOLDER — à confirmer par le DPO avant la production.
AUDIT_RETENTION_MONTHS=36

# Secret partagé du webhook entrant Brevo (réponse SMS OUI/NON au rappel,
# phase 4 lot 4). FACULTATIF, minimum 32 caractères : sans lui, la route
# /api/webhooks/brevo/sms répond 404 et les rappels n'invitent pas à répondre.
# Transmis par Brevo en en-tête "Authorization: Bearer <secret>" (à configurer
# côté Brevo comme en-tête personnalisé du webhook — voir le commentaire de
# src/app/api/webhooks/brevo/sms/route.ts pour ce que la documentation Brevo
# confirme, ou non, sur ce point).
BREVO_WEBHOOK_SECRET=

# Base des tests automatiques, SÉPARÉE de la base de travail.
# Le journal d'audit étant indestructible, les comptes créés par les tests ne
# peuvent jamais être supprimés : sans cette séparation ils s'accumulent dans la
# base qu'on regarde. La bascule est faite par vitest.config.mts.
TEST_DATABASE_URL=
TEST_DIRECT_DATABASE_URL=

# Base de démonstration (cabinet_demo), rôle propriétaire : traitée par db:security si définie.
DEMO_DIRECT_DATABASE_URL=

# Assistant des urgences (D77) : clé API de la console Anthropic (console.anthropic.com), jamais un abonnement
# claude.ai. Vide : la bulle « Urgence dentaire ? » n'apparaît pas sur le site.
ANTHROPIC_API_KEY=
# Facultatifs : le modèle (défaut claude-sonnet-5-5) et le plafond de conversations par jour pour tout le site (défaut 200).
ASSISTANT_MODELE=
ASSISTANT_PLAFOND_JOUR=
# Sans clé : 1 affiche la bulle avec le modèle de démonstration intégré (aucun service extérieur, rien de débité).
ASSISTANT_SCRIPTE=
